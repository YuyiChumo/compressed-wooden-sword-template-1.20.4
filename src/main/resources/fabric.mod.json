{
	"schemaVersion": 1,
	"id": "compressed-wooden-sword",
	"version": "${version}",
	"name": "压缩木剑 (Compressed Wooden Sword)",
	"description": "添加了从一重到九重的压缩木棍，以及一把威力巨大的压缩木剑",
	"authors": [
		"Github: YuyiChumo"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/compressed-wooden-sword/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.yuyichumo.compressedwood.CompressedWoodenSword"
		],
		"client": [
			"com.yuyichumo.compressedwood.client.CompressedWoodenSwordClient"
		]
	},
	"mixins": [
		"compressed-wooden-sword.mixins.json",
		{
			"config": "compressed-wooden-sword.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}